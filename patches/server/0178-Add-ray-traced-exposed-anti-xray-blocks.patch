+        RayTraceChunk previousRayTraceChunk = rayTraceChunks.get(key);
+        List<BlockPosition> mergedRayTraceBlocks = new ArrayList<>();
+
+        if (previousRayTraceChunk != null) {
+            for (BlockPosition rayTraceBlock : previousRayTraceChunk.getBlocks()) {
+                int sectionIndex = rayTraceBlock.getY() >> 4;
