+    private List<BlockPosition> collectRayTraceBlocks(PacketPlayOutMapChunkInfoAntiXray packetPlayOutMapChunkInfoAntiXray) {
+        List<BlockPosition> rayTraceBlocks = new ArrayList<>();
+        Chunk chunk = packetPlayOutMapChunkInfoAntiXray.getChunk();
+        ChunkSection[] chunkSections = chunk.getSections();
+        Chunk[] nearbyChunks = packetPlayOutMapChunkInfoAntiXray.getNearbyChunks();
+        int minBlockX = chunk.locX << 4;
+        int minBlockZ = chunk.locZ << 4;
+
+        for (int chunkSectionIndex = 0; chunkSectionIndex <= maxChunkSectionIndex && rayTraceBlocks.size() < rayTraceMaxBlockCountPerChunk; chunkSectionIndex++) {
+            if (!packetPlayOutMapChunkInfoAntiXray.isWritten(chunkSectionIndex) || packetPlayOutMapChunkInfoAntiXray.getPredefinedBlockData(chunkSectionIndex) == null) {
+                continue;
+            }
+
+            ChunkSection chunkSection = chunkSections[chunkSectionIndex];
+
+            if (chunkSection == Chunk.EMPTY_CHUNK_SECTION) {
+                continue;
+            }
+
+            int baseY = chunkSectionIndex << 4;
+
+            for (int y = 0; y < 16 && rayTraceBlocks.size() < rayTraceMaxBlockCountPerChunk; y++) {
+                int blockY = baseY + y;
+
+                for (int z = 0; z < 16 && rayTraceBlocks.size() < rayTraceMaxBlockCountPerChunk; z++) {
+                    for (int x = 0; x < 16 && rayTraceBlocks.size() < rayTraceMaxBlockCountPerChunk; x++) {
+                        IBlockData blockData = chunkSection.getType(x, y, z);
+
+                        if (rayTraceGlobal[Block.REGISTRY_ID.getId(blockData)] && isExposed(chunk, nearbyChunks, x, blockY, z)) {
+                            rayTraceBlocks.add(new BlockPosition(minBlockX + x, blockY, minBlockZ + z));
+                        }
+                    }
+                }
+            }
+        }
+
+        return rayTraceBlocks;
+    }
+
+    private boolean isExposed(Chunk chunk, Chunk[] nearbyChunks, int x, int y, int z) {
+        return isTransparent(chunk, nearbyChunks, x - 1, y, z)
+                || isTransparent(chunk, nearbyChunks, x + 1, y, z)
+                || isTransparent(chunk, nearbyChunks, x, y - 1, z)
+                || isTransparent(chunk, nearbyChunks, x, y + 1, z)
+                || isTransparent(chunk, nearbyChunks, x, y, z - 1)
+                || isTransparent(chunk, nearbyChunks, x, y, z + 1);
+    }
+
+    private boolean isTransparent(Chunk chunk, Chunk[] nearbyChunks, int x, int y, int z) {
+        if (y < 0 || y >= 256) {
+            return true;
+        }
+
+        Chunk targetChunk = chunk;
+
+        if (x < 0) {
+            targetChunk = nearbyChunks[0];
+            x = 15;
+        } else if (x > 15) {
+            targetChunk = nearbyChunks[1];
+            x = 0;
+        } else if (z < 0) {
+            targetChunk = nearbyChunks[2];
+            z = 15;
+        } else if (z > 15) {
+            targetChunk = nearbyChunks[3];
+            z = 0;
+        }
+
+        if (targetChunk == null) {
+            return true;
+        }
+
+        ChunkSection chunkSection = targetChunk.getSections()[y >> 4];
+        return chunkSection == Chunk.EMPTY_CHUNK_SECTION || !solidGlobal[Block.REGISTRY_ID.getId(chunkSection.getType(x, y & 15, z))];
+    }
+
+    private void hideRayTraceBlocks(PacketPlayOutMapChunkInfoAntiXray packetPlayOutMapChunkInfoAntiXray) {
+        List<BlockPosition> rayTraceBlocks = packetPlayOutMapChunkInfoAntiXray.getRayTraceBlocks();
+
+        if (!rayTraceExposedBlocks || rayTraceBlocks == null || rayTraceBlocks.isEmpty()) {
+            return;
+        }
+
+        Set<Long> rayTraceBlockSet = new HashSet<>();
+        boolean[] sectionHasRayTraceBlocks = new boolean[16];
+
+        for (BlockPosition rayTraceBlock : rayTraceBlocks) {
+            rayTraceBlockSet.add(rayTraceBlock.asLong());
+            sectionHasRayTraceBlocks[rayTraceBlock.getY() >> 4] = true;
+        }
+
