+        for (int chunkX = playerChunkX - chunkRadius; chunkX <= playerChunkX + chunkRadius; chunkX++) {
+            for (int chunkZ = playerChunkZ - chunkRadius; chunkZ <= playerChunkZ + chunkRadius; chunkZ++) {
+                RayTraceChunk rayTraceChunk = rayTraceChunks.get(ChunkCoordIntPair.asLong(chunkX, chunkZ));
+
+                if (rayTraceChunk == null) {
+                    continue;
+                }
+
+                Chunk chunk = rayTraceChunk.getChunk();
+
+                if (chunk == null || !chunk.isLoaded()) {
+                    rayTraceChunks.remove(ChunkCoordIntPair.asLong(chunkX, chunkZ), rayTraceChunk);
+                    continue;
+                }
+
+                PlayerChunk playerChunk = world.getPlayerChunkMap().getChunk(chunkX, chunkZ);
+
+                if (playerChunk == null || !playerChunk.d(player)) {
+                    continue;
+                }
+
+                for (BlockPosition rayTraceBlock : rayTraceChunk.getBlocks()) {
+                    if (isWithinRayTraceDistance(player, rayTraceBlock) && isRayTraceVisible(player, rayTraceBlock)) {
+                        IBlockData blockData = player.world.getTypeIfLoaded(rayTraceBlock);
+
+                        if (blockData != null && rayTraceGlobal[Block.REGISTRY_ID.getId(blockData)]) {
+                            currentVisibleBlocks.add(rayTraceBlock);
+                        }
+                    }
+                }
+            }
+        }
+
+        for (BlockPosition rayTraceBlock : currentVisibleBlocks) {
+            invisibleBlockMisses.remove(rayTraceBlock);
+
+            if (!previousVisibleBlocks.contains(rayTraceBlock)) {
+                IBlockData blockData = player.world.getTypeIfLoaded(rayTraceBlock);
+
+                if (blockData != null) {
+                    player.playerConnection.sendPacket(new PacketPlayOutBlockChange(rayTraceBlock, blockData));
+                    sendTileEntityUpdate(player, rayTraceBlock);
+                }
+            }
+        }
+
+        for (BlockPosition rayTraceBlock : previousVisibleBlocks) {
+            if (!currentVisibleBlocks.contains(rayTraceBlock) && isChunkSentToPlayer(player, rayTraceBlock)) {
+                IBlockData blockData = player.world.getTypeIfLoaded(rayTraceBlock);
+
+                if (blockData == null || !rayTraceGlobal[Block.REGISTRY_ID.getId(blockData)]) {
+                    invisibleBlockMisses.remove(rayTraceBlock);
+                    continue;
+                }
+
+                int misses = invisibleBlockMisses.containsKey(rayTraceBlock) ? invisibleBlockMisses.get(rayTraceBlock) + 1 : 1;
+
+                if (misses < 3) {
+                    invisibleBlockMisses.put(rayTraceBlock, misses);
+                    currentVisibleBlocks.add(rayTraceBlock);
+                    continue;
+                }
+
+                invisibleBlockMisses.remove(rayTraceBlock);
+                player.playerConnection.sendPacket(new PacketPlayOutBlockChange(rayTraceBlock, getReplacementBlockData(player.world, rayTraceBlock.getY())));
+            }
+        }
+
+        previousVisibleBlocks.clear();
+        previousVisibleBlocks.addAll(currentVisibleBlocks);
+    }
