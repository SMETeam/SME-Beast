+    private static IBlockData[] getConfiguredBlockData(List<Object> blockIds, IBlockData fallbackBlockData) {
+        List<IBlockData> blockData = new ArrayList<IBlockData>();
+
+        for (Object id : blockIds) {
+            Block block = Block.getByName(String.valueOf(id));
+
+            if (block != null) {
+                addBlockData(blockData, block.getBlockData());
+            }
+        }
+
+        if (blockData.isEmpty()) {
+            blockData.add(fallbackBlockData);
+        }
+
+        return blockData.toArray(new IBlockData[blockData.size()]);
+    }
+
+    private static IBlockData[] mergeBlockData(IBlockData[] first, IBlockData[] second) {
+        List<IBlockData> blockData = new ArrayList<IBlockData>(first.length + second.length);
+
+        for (IBlockData data : first) {
+            addBlockData(blockData, data);
+        }
+
+        for (IBlockData data : second) {
+            addBlockData(blockData, data);
+        }
+
+        return blockData.toArray(new IBlockData[blockData.size()]);
+    }
