+    private boolean shouldRevealAntiFreecamChunk(EntityPlayer player, Chunk chunk) {
+        if (!antiFreecamEnabled) {
+            return true;
+        }
+
+        if (player == null || chunk == null || player.world != chunk.world) {
+            return false;
+        }
+
+        if (!isAntiFreecamUnderground(player)) {
+            return false;
+        }
+
+        long chunkKey = ChunkCoordIntPair.asLong(chunk.locX, chunk.locZ);
+        AntiFreecamPlayerState state = getAntiFreecamPlayerState(player);
+
+        synchronized (state) {
+            if (state.revealedChunks.contains(chunkKey)) {
+                return true;
+            }
+
+            if (isWithinAntiFreecamRadius(player, chunk.locX, chunk.locZ, antiFreecamInitialRadius)) {
+                if (state.revealedChunks.add(chunkKey)) {
+                    queueAntiFreecamReveal(state, chunkKey);
+
+                    if (antiFreecamHideEntities) {
+                        state.entityTrackerRefreshNeeded = true;
+                    }
+                }
+
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private boolean shouldHideAntiFreecamBlock(EntityPlayer player, World world, BlockPosition blockPosition) {
+        if (!antiFreecamEnabled || blockPosition == null || blockPosition.getY() >= antiFreecamMaskBelowY) {
+            return false;
+        }
+
+        if (player == null || world == null || player.world != world) {
+            return true;
+        }
+
+        if (!isAntiFreecamUnderground(player)) {
+            return true;
+        }
+
+        Chunk chunk = world.getChunkIfLoaded(blockPosition);
+        return chunk == null || !shouldRevealAntiFreecamChunk(player, chunk);
+    }
+
+    private boolean shouldHideAntiFreecamEntityData(EntityPlayer player, World world, BlockPosition blockPosition) {
+        return antiFreecamHideEntities && shouldHideAntiFreecamBlock(player, world, blockPosition);
+    }
+
+    private boolean isAntiFreecamUnderground(EntityPlayer player) {
+        return player != null && player.locY < (double) (antiFreecamMaskBelowY + antiFreecamVerticalGrace);
+    }
+
+    private boolean isWithinAntiFreecamRadius(EntityPlayer player, int chunkX, int chunkZ, int radius) {
+        int playerChunkX = MathHelper.floor(player.locX) >> 4;
+        int playerChunkZ = MathHelper.floor(player.locZ) >> 4;
+        return Math.abs(chunkX - playerChunkX) <= radius && Math.abs(chunkZ - playerChunkZ) <= radius;
