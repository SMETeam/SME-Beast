+    private void hideAntiFreecamBlocks(PacketPlayOutMapChunkInfoAntiXray packetPlayOutMapChunkInfoAntiXray) {
+        if (!antiFreecamEnabled || antiFreecamMaskMaxChunkSectionIndex < 0 || shouldRevealAntiFreecamChunk(packetPlayOutMapChunkInfoAntiXray.getPlayer(), packetPlayOutMapChunkInfoAntiXray.getChunk())) {
+            return;
+        }
+
+        dataBitsWriter.setDataBits(packetPlayOutMapChunkInfoAntiXray.getData());
+
+        for (int chunkSectionIndex = 0; chunkSectionIndex <= antiFreecamMaskMaxChunkSectionIndex; chunkSectionIndex++) {
+            if (!packetPlayOutMapChunkInfoAntiXray.isWritten(chunkSectionIndex) || packetPlayOutMapChunkInfoAntiXray.getDataPalette(chunkSectionIndex) == null) {
+                continue;
+            }
+
+            int maskBlockDataBits = getAntiFreecamMaskBlockDataBits(packetPlayOutMapChunkInfoAntiXray, chunkSectionIndex);
+            dataBitsWriter.setBitsPerValue(packetPlayOutMapChunkInfoAntiXray.getBitsPerValue(chunkSectionIndex));
+            dataBitsWriter.setIndex(packetPlayOutMapChunkInfoAntiXray.getDataBitsIndex(chunkSectionIndex));
+            int baseY = chunkSectionIndex << 4;
+
+            for (int y = 0; y < 16; y++) {
+                boolean maskY = baseY + y < antiFreecamMaskBelowY;
+
+                for (int z = 0; z < 16; z++) {
+                    for (int x = 0; x < 16; x++) {
+                        if (maskY) {
+                            dataBitsWriter.write(maskBlockDataBits);
+                        } else {
+                            dataBitsWriter.skip();
+                        }
+                    }
+                }
+            }
+
+            dataBitsWriter.finish();
+        }
+    }
+
+    private int getAntiFreecamMaskBlockDataBits(PacketPlayOutMapChunkInfoAntiXray packetPlayOutMapChunkInfoAntiXray, int chunkSectionIndex) {
+        if (packetPlayOutMapChunkInfoAntiXray.getDataPalette(chunkSectionIndex) instanceof DataPaletteGlobal) {
+            return Block.REGISTRY_ID.getId(antiFreecamMaskBlockData);
+        }
+
+        return packetPlayOutMapChunkInfoAntiXray.getDataPalette(chunkSectionIndex).getDataBits(antiFreecamMaskBlockData);
+    }
