+    private boolean getAntiFreecamBoolean(String path, boolean def) {
+        Object value = getAntiFreecamValue(path, def);
+        if (value instanceof Boolean) {
+            return ((Boolean) value).booleanValue();
+        }
+
+        if (value instanceof String) {
+            return Boolean.parseBoolean((String) value);
+        }
+
+        return def;
+    }
+
+    private int getAntiFreecamInt(String path, int def) {
+        Object value = getAntiFreecamValue(path, def);
+        if (value instanceof Number) {
+            return ((Number) value).intValue();
+        }
+
+        if (value instanceof String) {
+            try {
+                return Integer.parseInt((String) value);
+            } catch (NumberFormatException ignored) {
+                return def;
+            }
+        }
+
+        return def;
+    }
+
+    private String getAntiFreecamString(String path, String def) {
+        Object value = getAntiFreecamValue(path, def);
+        return value == null ? def : value.toString();
+    }
+
+    private Object getAntiFreecamValue(String path, Object def) {
+        String fullPath = "anti-freecam." + path;
+        String worldPath = "world-settings." + worldName + "." + fullPath;
+        String defaultPath = "world-settings.default." + fullPath;
+
+        config.addDefault(defaultPath, def);
+
+        if (config.get(worldPath) != null) {
+            return config.get(worldPath);
+        }
+
+        if (config.get(fullPath) != null) {
+            return config.get(fullPath);
+        }
+
+        return config.get(defaultPath, def);
+    }
