+    // Beast start - Refresh anti-freecam visibility through the normal tracker spawn/destroy path
+    private void refreshAntiFreecamTracking(MobEffect mobeffect) {
+        if (mobeffect.getMobEffect() == MobEffects.GLOWING) {
+            this.refreshAntiFreecamTracking();
         }
+    }
 
+    private void refreshAntiFreecamTracking() {
+        if (this.world instanceof WorldServer) {
+            ((WorldServer) this.world).getTracker().refreshEntityTracking(this);
+        }
     }
+    // Beast end
 
