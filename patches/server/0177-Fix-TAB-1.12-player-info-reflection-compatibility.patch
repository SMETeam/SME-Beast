diff --git a/src/test/java/net/minecraft/server/PacketPlayOutPlayerInfoTest.java b/src/test/java/net/minecraft/server/PacketPlayOutPlayerInfoTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..fd8309d46df47dc5abb8ca063a4d7707a5185a9a
--- /dev/null
+++ b/src/test/java/net/minecraft/server/PacketPlayOutPlayerInfoTest.java
@@ -0,0 +1,33 @@
+package net.minecraft.server;
+
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertThat;
+
+import com.mojang.authlib.GameProfile;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+
+public class PacketPlayOutPlayerInfoTest {
+
+    @Test
+    public void tabPluginCompatibleInnerClassOrder() {
+        Class<?> playerInfoDataClass = PacketPlayOutPlayerInfo.class.getDeclaredClasses()[0];
+
+        assertThat(playerInfoDataClass.getSimpleName(), is("PlayerInfoData"));
+        assertThat(fieldsOfType(playerInfoDataClass, GameProfile.class).size(), is(1));
+    }
+
+    private static List<Field> fieldsOfType(Class<?> clazz, Class<?> type) {
+        List<Field> fields = new ArrayList<Field>();
+
+        for (Field field : clazz.getDeclaredFields()) {
+            if (field.getType() == type) {
+                fields.add(field);
+            }
+        }
+
+        return fields;
+    }
+}
